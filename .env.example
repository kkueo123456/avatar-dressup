# ─────────────────────────────────────────────────────────────
# 环境变量模板：cp .env.example .env 后按需修改
# .env 被 gitignore，不会提交；服务器上的 .env 单独维护
# ─────────────────────────────────────────────────────────────

# 数据库连接（PostgreSQL，本地与生产一致）
# 本地快速起步（Docker）：
#   docker run -d --name avatar-pg -e POSTGRES_PASSWORD=dev123 -e POSTGRES_USER=avatar -e POSTGRES_DB=avatar_dressup -p 5432:5432 postgres:15
#   然后 DATABASE_URL 填 postgresql://avatar:dev123@localhost:5432/avatar_dressup
# 生产：换成服务器上的实际连接串（见 docs/deploy.md）
DATABASE_URL="postgresql://avatar:dev123@localhost:5432/avatar_dressup"

# JWT 会话签名密钥
# 生产必须换强随机值，至少 16 字符，例如：openssl rand -base64 32
# 生产未配置或过短（<16 字符）时应用会在处理请求时直接报错（fail-fast）
JWT_SECRET="dev-only-change-me"

# 海报生成服务选择（worker 进程必需，缺失时 worker 启动即报错退出）
# mock = 本地合成图的假适配器（sharp 风格化，无需联网/计费）
# real = 通义万相真实图生图（需同时配置 DASHSCOPE_API_KEY）
POSTER_PROVIDER=mock

# 通义万相（阿里云百炼 / DashScope）API Key，仅 POSTER_PROVIDER=real 时使用
# 获取：阿里云百炼控制台 → API-KEY 管理 → 创建；约 $0.02/张（仅成功出图计费）
DASHSCOPE_API_KEY=

# ── 以下为可选构建期变量（改了要重新 build）────────────────
# 静态资源基础路径；默认同源 /avatar/
NEXT_PUBLIC_ASSET_BASE=/avatar/
# 首页顶栏的 GitHub 链接，留空则不显示该按钮
NEXT_PUBLIC_REPO_URL=

# ── 以下为可选运行时变量 ──────────────────────────────────
# POSTER_QUEUE_INTERVAL_MS=5000   # worker 空闲轮询间隔（毫秒）
