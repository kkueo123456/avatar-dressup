# 生产环境配置模板
# 复制到服务器上的 .env 并填写实际值

# PostgreSQL 数据库（服务器上安装）
DATABASE_URL="postgresql://avatar:YOUR_PASSWORD@localhost:5432/avatar_dressup"

# JWT 密钥（生产环境必须更换为强随机字符串）
JWT_SECRET="change-this-to-a-random-string-at-least-32-chars"

# Next.js
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 可选：海报 Worker 配置
# POSTER_QUEUE_INTERVAL_MS=5000
